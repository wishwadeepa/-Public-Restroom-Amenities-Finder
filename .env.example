# Application Environment Configuration Example
# Copy this file to .env.local for local development

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connection (PostgreSQL or SQLite for local dev)
DATABASE_URL="file:./dev.db"

# Geospatial Default Map Center (Default: San Francisco)
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=37.7749
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LNG=-122.4194
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=14

# Rate Limiting Parameters (Requests per minute window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
